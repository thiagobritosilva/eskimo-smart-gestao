# ===== ESKIMO SMART GESTÃO — variáveis de ambiente =====
# Copie para .env e ajuste. NUNCA versione o arquivo .env.

NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgres://eskimo:eskimo_dev@localhost:5432/eskimo_dev
DATABASE_SSL=false

# Endereço público do front-end (CSRF/Origin). Em dev, o Vite roda em 5173.
APP_ORIGIN=http://localhost:5173

# Chave de 32 bytes em base64 para cifrar credenciais de integração (PDV, IA).
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde em local seguro: sem ela, credenciais cifradas não podem ser recuperadas.
APP_ENCRYPTION_KEY=

SESSION_COOKIE_NAME=esg_session
LOGIN_RATE_LIMIT=10
LOG_LEVEL=info

# Produção: atrás de proxy/load balancer com HTTPS
TRUST_PROXY=false
# Produção: a API serve o build do front-end
# WEB_DIST_DIR=/app/web
