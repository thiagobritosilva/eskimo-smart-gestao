# HTTPS automático (Let's Encrypt) para o domínio configurado; renovação automática.
{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy app:3333
}

# "www" redireciona permanentemente para o endereço principal (certificado emitido também para o www).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Outros sistemas no mesmo servidor (opcional): cada arquivo *.caddy em /opt/caddy-sites vira um site.
# Sem arquivos lá, nada muda. Os serviços desses sites ficam na rede docker "edge".
import /etc/caddy/sites/*.caddy
