# HTTPS automático (Let's Encrypt) para o domínio configurado; renovação automática.
{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy app:3333
}

# "www" redireciona permanentemente para o endereço principal (certificado emitido também para o www).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
