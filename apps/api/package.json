{
  "name": "@eskimo/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "create-owner": "tsx --env-file-if-exists=../../.env src/scripts/create-owner.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.8",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
